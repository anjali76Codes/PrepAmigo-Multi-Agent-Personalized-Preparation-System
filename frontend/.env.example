# Copy this file to .env and fill in values. Never commit .env to source control.

# ── API Gateway ───────────────────────────────────────────────
# URL of the Node.js backend. Set this in Vercel's build environment for production.
# Leave the local value for development. If the backend is hosted separately, this must be set before production build.
VITE_API_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=

# ── Feature Flags ─────────────────────────────────────────────
# Toggle Google OAuth / JWT auth flow on the frontend.
# When false the app skips the auth gate and loads as a guest.
VITE_ENABLE_AUTH=false         # true | false

# Toggle SerpAPI-powered search features visible in the UI.
# When false any UI that would call SerpAPI-backed endpoints is hidden or stubbed.
VITE_ENABLE_SERPAPI=false      # true | false