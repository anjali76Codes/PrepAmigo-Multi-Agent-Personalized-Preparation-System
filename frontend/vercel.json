{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://prepamigo-backend.onrender.com/api/:path*"
    },
    {
      "source": "/internal/:path*",
      "destination": "https://prepamigo-backend.onrender.com/internal/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
