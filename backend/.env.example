# Node environment. Auth bypass is development-only; production requires JWT.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Required for Google OAuth; keep the credential out of committed files.
GOOGLE_CLIENT_ID=
# Required to sign/verify sessions. Use a long, private random value locally.
JWT_SECRET=
# true requires a valid cookie/Bearer JWT in development too; production always requires auth.
ENABLE_AUTH=false
# Required MongoDB connection URI. Do not commit a real URI.
MONGODB_URI=
# Optional Google OAuth client secret if the chosen OAuth flow needs one.
# GOOGLE_CLIENT_SECRET=
# Frontend origin allowed by CORS.
FRONTEND_URL=http://localhost:5173
# Redis carries SSE events and replay history.
REDIS_URL=redis://localhost:6379
# Python LangGraph service base URL.
AGENTS_SERVICE_URL=http://localhost:8000

# Optional API credentials. Keep them private; blank disables those providers.
SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
# Optional OpenAI settings when using the OpenAI provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=