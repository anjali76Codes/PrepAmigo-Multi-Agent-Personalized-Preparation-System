# Node environment. Auth bypass is development-only; production requires JWT.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Required for Google OAuth; keep the credential out of committed files.
GOOGLE_CLIENT_ID=
# Required to sign/verify sessions. Use a long, private random value locally.
JWT_SECRET=
# true requires a valid cookie/Bearer JWT in development too; production always requires auth.
ENABLE_AUTH=false
# Required MongoDB connection URI. Do not commit a real URI.
MONGODB_URI=
# Optional Google OAuth client secret if the chosen OAuth flow needs one.
# GOOGLE_CLIENT_SECRET=
# Frontend origin allowed by CORS.
FRONTEND_URL=http://localhost:5173
# Redis carries SSE events and replay history.
REDIS_URL=redis://localhost:6379
# Python LangGraph service base URL. Replace localhost with the deployed service URL in production.
AGENTS_SERVICE_URL=http://localhost:8000

# Optional API credentials. Keep them private; blank disables those providers.
SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
# Optional OpenAI settings when using the OpenAI provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Outbound email (morning task digest). Blank SMTP_HOST disables sending;
# the digest notification still won't be created since nothing was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PrepAmigo <no-reply@prepamigo.app>
# Hour (0-23, in each user's own profile.timezone, server time if unset) the
# morning digest email + notification goes out. Checked hourly, so this is
# exact to the hour, not the minute.
ENABLE_DAILY_DIGEST=true
DAILY_DIGEST_HOUR=7
# POST /api/notifications/test-digest (send the digest now, for testing).
# Unset: enabled outside production, disabled in production.
# ENABLE_TEST_NOTIFICATIONS=