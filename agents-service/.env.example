# --- LLM provider switch ---
LLM_PROVIDER=ollama            # ollama | openai
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Tools ---
SERPAPI_API_KEY=

# --- Long-term memory ---
MEMORY_PROVIDER=local          # local | mem0 (hosted Platform) | mem0_oss (self-hosted)
# JSON file for local memory; empty = in-process only
MEMORY_STORE_PATH=

# mem0 Platform (MEMORY_PROVIDER=mem0): get a key at https://app.mem0.ai/dashboard/api-keys
MEM0_API_KEY=
# optional; defaults to https://api.mem0.ai
MEM0_HOST=

# self-hosted mem0 (MEMORY_PROVIDER=mem0_oss)
MEM0_DATA_DIR=.data/mem0       # local Qdrant + SQLite history
# set to use a Qdrant server instead of local storage
MEM0_QDRANT_URL=
MEM0_QDRANT_API_KEY=
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Knowledge graph ---
# JSON file for the user knowledge graph; empty = in-process only
# Not currently written by the research agent (see graph/knowledge_graph.py);
# reserved for the skill-gap/assessment agents.
KNOWLEDGE_GRAPH_PATH=

# --- Research tool cache (tools/cache.py) ---
# cache raw SerpApi/tool responses as inspectable JSON so repeated dev/test
# runs don't spend SerpApi credits; disable to always hit the live API
RESEARCH_CACHE_ENABLED=true
RESEARCH_CACHE_DIR=.data/research_cache
# seconds a cached response stays valid; 0 = never expires
RESEARCH_CACHE_TTL_SECONDS=604800

# --- Research agent tuning (agents/research_agent.py) ---
# budget for the tool-orchestration phase: memory recall, scoping, and the
# parallel docs/books/papers/videos/transcript calls
RESEARCH_TIMEOUT_SECONDS=30
# separate budget for the LLM call that writes the module (model speed, not
# tool efficiency, so it doesn't share the budget above)
RESEARCH_SYNTHESIS_TIMEOUT_SECONDS=45
# per-tool-call timeout inside the research-phase budget
RESEARCH_TOOL_TIMEOUT_SECONDS=12

# --- Runtime & messaging ---
LOG_LEVEL=INFO
# rotating log file for inspection (step/tool timings, errors); under .data/
# so it's gitignored. Empty = console-only output
LOG_FILE=.data/logs/agents-service.log
LOG_FILE_MAX_BYTES=5000000
REDIS_URL=redis://localhost:6379
# streaming/runner.py: emit a scripted demo instead of running the real
# graph, for frontend/SSE development without a live model. Set to false
# to drive /internal/agent/execute with the actual multi-agent graph.
USE_DUMMY_STREAM=true
# stream reply tokens as they are generated: the CLI default (override with
# --stream / --no-stream) and whether /api/chat/stream and the SSE runner
# send token-level events
STREAM_RESPONSES=true
