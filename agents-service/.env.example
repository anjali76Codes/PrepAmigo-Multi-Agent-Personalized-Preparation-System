# Copy this file to .env, then set credentials in .env only.
# Example files intentionally contain no credentials or private endpoints.

# --- LLM provider and model selection ---
# Select the provider used for extraction, routing, synthesis, and agent replies.
LLM_PROVIDER=ollama            # ollama | openai
# Local Ollama model name and service URL.
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
# OpenAI model and key; the key is required only when LLM_PROVIDER=openai.
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Tools ---
# Used only when live SerpApi requests are enabled.
SERPAPI_API_KEY=
# Major cost switch: false prevents all Python SerpApi-backed tools from making live requests.
SERPAPI_ENABLED=false
# Provider-shaped fixture data used when SERPAPI_ENABLED=false.
SERPAPI_DUMMY_DATA_PATH=serpapi_fixtures.example.json

# --- Long-term memory ---
# local stores memory on this process (optionally a JSON file); mem0 uses the hosted service;
# mem0_oss uses local/self-hosted storage. Memory is user-scoped by user_id.
MEMORY_PROVIDER=local          # local | mem0 (hosted Platform) | mem0_oss (self-hosted)
# Optional local-memory JSON file. Empty means process-local memory only.
MEMORY_STORE_PATH=

# Hosted Mem0 credentials (used only with MEMORY_PROVIDER=mem0).
MEM0_API_KEY=
# Optional hosted Mem0 base URL; defaults to the provider's standard endpoint.
MEM0_HOST=

# Self-hosted Mem0 storage (used only with MEMORY_PROVIDER=mem0_oss).
MEM0_DATA_DIR=.data/mem0
# Optional Qdrant server; empty uses the local Qdrant path under MEM0_DATA_DIR.
MEM0_QDRANT_URL=
MEM0_QDRANT_API_KEY=
# Embedding models used by the selected Mem0 provider.
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Knowledge graph ---
# Optional JSON persistence path for the knowledge graph. Empty is process-local.
# The current research agents do not write this graph; it is reserved for skill-gap workflows.
KNOWLEDGE_GRAPH_PATH=

# --- Research tool cache (tools/cache.py) ---
# Enables file caching for eligible Content/Interview Research provider responses.
# Disable to bypass the cache. Fixture mode bypasses this live-response cache automatically.
RESEARCH_CACHE_ENABLED=true
RESEARCH_CACHE_DIR=.data/research_cache
# Cache lifetime in seconds; 0 means entries do not expire.
RESEARCH_CACHE_TTL_SECONDS=604800

# --- Research agent tuning (agents/research_agent.py) ---
# Wall-clock budget for memory recall, scoping, and parallel resource searches.
RESEARCH_TIMEOUT_SECONDS=30
# Separate model-generation budget for writing the learning module.
RESEARCH_SYNTHESIS_TIMEOUT_SECONDS=45
# Timeout for an individual search/transcript tool call.
RESEARCH_TOOL_TIMEOUT_SECONDS=12

# --- Runtime & messaging ---
# Console/file log verbosity.
LOG_LEVEL=INFO
# Rotating log location; empty disables file logging and keeps console output only.
LOG_FILE=.data/logs/agents-service.log
LOG_FILE_MAX_BYTES=5000000
# Redis is used for Node/Python SSE event delivery and event-history replay.
REDIS_URL=redis://localhost:6379
# Major execution-path switch: true emits the scripted SSE demo for ordinary runs;
# false executes the real LangGraph. Interview-prep workflow requests always execute the real graph.
USE_DUMMY_STREAM=true
# Enables token streaming where supported; Redis/SSE primarily sends step/domain events.
STREAM_RESPONSES=true
# Optional JWT secret. Python auth bypass is controlled by ENABLE_AUTH in src/auth.py;
# set that constant to true before relying on JWT validation in production.
JWT_SECRET=
# Require JWT verification in development when true. Production always enforces auth.
ENABLE_AUTH=false
