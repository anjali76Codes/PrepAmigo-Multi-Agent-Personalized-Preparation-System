# Copy this file to .env, then set credentials in .env only.
# Example files intentionally contain no credentials or private endpoints.

# --- LLM provider and model selection ---
# Select the provider used for extraction, routing, synthesis, and agent replies.
LLM_PROVIDER=ollama            # ollama | openai
# Local Ollama model name and service URL.
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
# Thinking models (e.g. nemotron-3-nano) write a hidden reasoning trace before
# every answer: ~4x the output tokens and unbounded latency for no visible
# gain in this pipeline. false = off (default, harmless on non-thinking
# models), true = on, empty = the model's own default.
OLLAMA_REASONING=false
# OpenAI model and key; the key is required only when LLM_PROVIDER=openai.
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Fast model profile (optional) ---
# A second OpenAI-compatible endpoint for small, latency-sensitive calls. Only agents
# whose *_LLM setting is "fast" use it; leave empty to use the main model everywhere.
# Example (Groq): FAST_LLM_BASE_URL=https://api.groq.com/openai/v1 and the model id
# exactly as Groq's model list shows it.
FAST_LLM_BASE_URL=
FAST_LLM_MODEL=
FAST_LLM_API_KEY=
# Sent as `reasoning_effort` when set ("none" turns off a thinking model's hidden
# reasoning on Groq, which otherwise spends output tokens). Empty sends nothing.
FAST_LLM_REASONING_EFFORT=
# Concurrent calls to the fast model where a stage fans out (planner chunks).
FAST_LLM_MAX_CONCURRENCY=2

# --- Tools ---
# Used only when live SerpApi requests are enabled.
SERPAPI_API_KEY=
# SerpApi is usually 1-3s but occasionally hangs. Each attempt is cut off after this many
# seconds and retried, up to SERPAPI_MAX_ATTEMPTS.
SERPAPI_ATTEMPT_TIMEOUT_SECONDS=8
SERPAPI_MAX_ATTEMPTS=2
# SerpApi requests in flight at once; more than a few at a time answered slowly or timed out.
SERPAPI_MAX_CONCURRENCY=4
# Major cost switch: false prevents all Python SerpApi-backed tools from making live requests.
SERPAPI_ENABLED=false
# Provider-shaped fixture data used when SERPAPI_ENABLED=false.
SERPAPI_DUMMY_DATA_PATH=serpapi_fixtures.example.json
# Google's AI Overview panel adds several extra seconds to a plain `google`
# engine call even when nothing reads it; true forces the AI-Overview-free
# view for every `google` call except tools that explicitly opt out per-call
# (e.g. search_google_interview_sources, which reads the overview on purpose).
SERPAPI_SUPPRESS_AI_OVERVIEW=true
# Engine for content-research docs searches. google (AI Overview suppressed) measured
# 1-2.5s per search; google_light measured 10-20s on the same account.
SERPAPI_WEB_ENGINE=google

# --- Long-term memory ---
# local stores memory on this process (optionally a JSON file); mem0 uses the hosted service;
# mem0_oss uses local/self-hosted storage. Memory is user-scoped by user_id.
MEMORY_PROVIDER=local          # local | mem0 (hosted Platform) | mem0_oss (self-hosted)
# Optional local-memory JSON file. Empty means process-local memory only.
MEMORY_STORE_PATH=

# Hosted Mem0 credentials (used only with MEMORY_PROVIDER=mem0).
MEM0_API_KEY=
# Optional hosted Mem0 base URL; defaults to the provider's standard endpoint.
MEM0_HOST=
# Longest startup waits for mem0 to connect before falling back to local memory.
MEMORY_CONNECT_TIMEOUT_SECONDS=10

# Self-hosted Mem0 storage (used only with MEMORY_PROVIDER=mem0_oss).
MEM0_DATA_DIR=.data/mem0
# Optional Qdrant server; empty uses the local Qdrant path under MEM0_DATA_DIR.
MEM0_QDRANT_URL=
MEM0_QDRANT_API_KEY=
# Embedding models used by the selected Mem0 provider.
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Knowledge graph ---
# Optional JSON persistence path for the knowledge graph. Empty is process-local.
# The current research agents do not write this graph; it is reserved for skill-gap workflows.
KNOWLEDGE_GRAPH_PATH=

# --- Caches (tools/cache.py, storage/llm_cache.py; see README "Caching") ---
# Caches every agent's live SerpApi responses and YouTube transcripts. false also
# disables the LLM cache. Fixture mode (SERPAPI_ENABLED=false) never caches API calls.
RESEARCH_CACHE_ENABLED=true
RESEARCH_CACHE_DIR=.data/research_cache
# Lifetime of web/YouTube/Scholar responses in seconds; 0 means entries do not expire.
RESEARCH_CACHE_TTL_SECONDS=604800
# News and job-listing responses change daily, so they expire sooner.
SERPAPI_FRESH_CACHE_TTL_SECONDS=86400
# Identical prompt + model + parameters reuses the stored answer: no tokens spent.
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=604800
# Development only: true makes every cache hit (API and LLM) wait as long as the
# original call took, so a cached run times like a live one with no credits or tokens
# spent. Keep false in production: hits return immediately.
CACHE_REPLAY_LATENCY=false
# Longest wait replayed for a single hit.
CACHE_REPLAY_MAX_SECONDS=30

# --- Research agent tuning (agents/research_agent.py) ---
# Wall-clock budget for memory recall, scoping, and parallel resource searches.
RESEARCH_TIMEOUT_SECONDS=30
# Separate model-generation budget for writing the learning module.
RESEARCH_SYNTHESIS_TIMEOUT_SECONDS=45
# Timeout for an individual search/transcript tool call (covers the SerpApi attempts
# below). A late SerpApi answer is still cached when it arrives.
RESEARCH_TOOL_TIMEOUT_SECONDS=20
# Resource kinds the research agent may search at all: docs, videos, books, papers,
# repos (repos: company module only). Remove one to switch it off for every topic.
RESEARCH_KINDS=docs,videos,books,papers,repos
# Most tokens one research write-up may generate (typical: ~1,000). Bounds the
# slow tail; Overview and Key Concepts, which the planner reads, come first. 0 = no cap.
RESEARCH_MAX_OUTPUT_TOKENS=1800
# Cap for the interview-prep pipeline's compact write-up (overview, key concepts,
# practice; ~350 tokens). The full reference sheet above is only written in chat.
RESEARCH_COMPACT_MAX_OUTPUT_TOKENS=600
# Reference books: catalogue = Open Library (free, no key, real books only);
# web = a "best books to learn X" SerpApi search (one credit; it returned job adverts).
BOOKS_SOURCE=catalogue
# A catalogue book is recommended only if established: this many editions, or this many
# readers who shelved it. New tools with no real book yet get no book.
BOOK_MIN_EDITIONS=2
BOOK_MIN_READERS=5
# Papers: arxiv (free API) or scholar (Google Scholar through SerpApi, one credit).
PAPERS_SOURCE=arxiv
# One small model call before any search that picks which kinds of resource (docs,
# videos, books, papers) to search for each skill gap, so searches that would only be
# dropped are never made (saves time and SerpApi credits). off = search every kind.
# off | default (main model) | fast
RESEARCH_SCOPE_LLM=off
# Optional model check of each topic's search results ("is this study material for this
# topic and role?"): drops sales pages, news clips and homonyms that word matching
# cannot. One small call per topic (~700 tokens). off | default (main model) | fast.
RESEARCH_JUDGE_LLM=off
# Share of a topic's significant words a search result's title+snippet must
# contain to be kept (drops off-topic hits like "Voting Assistance Guide" for a
# pre-sales query). 0 disables the filter.
RESEARCH_MIN_RELEVANCE=0.5

# --- Interview prep orchestrator tuning (agents/interview_prep_orchestrator.py) ---
# Budget for one company_research/job_intelligence/skill_gap branch. On a
# local model this can mean two serial LLM calls (tool-use decision, then
# synthesis) plus tool round trips, so it's generous by default.
INTERVIEW_PREP_BRANCH_TIMEOUT_SECONDS=90
# Budget for the LLM call that extracts required skills from job postings. The gap
# analysis and plan depend on it, so it gets more room than optional calls.
JOB_INTELLIGENCE_LLM_TIMEOUT_SECONDS=60
# --- Per-agent model routing ---
# *_LLM: default (the main model) or fast (FAST_LLM_*). *_MODEL: a different model on
# the main provider for that agent only, e.g. a smaller Ollama model; empty = main model.
# The planner writes short JSON, so a small quick model suits it.
PLANNER_LLM=default
PLANNER_MODEL=
JOB_INTELLIGENCE_LLM=default
JOB_INTELLIGENCE_MODEL=
# Model for the research write-ups (always on the main provider: ~14k tokens a run is
# more than a free fast tier allows per minute).
RESEARCH_MODEL=

# --- Skill gap ---
# Model that compares the resume to the required skills: default or fast (FAST_LLM_*).
# fast sends the resume text to that provider.
SKILL_GAP_LLM=default
# Most required skills compared, must-have first (0 = all). The plan covers at most
# PLAN_MAX_TOPICS gaps anyway.
SKILL_GAP_MAX_SKILLS=12
# Cap on the verdict list the model writes (~25 tokens per skill).
SKILL_GAP_MAX_OUTPUT_TOKENS=700
# Budget for that call; past it, verdicts come from the resume text (named = partial,
# not named = missing) instead of the model.
SKILL_GAP_LLM_TIMEOUT_SECONDS=45
# Closing status summary: default, fast, or off (built-in sentence, no model call).
EVALUATOR_LLM=default

# on = add one research module on the target company's own platform (its official docs
# site, GitHub and research, all taken from the company profile) and put it first in the
# plan. Costs ~2 SerpApi credits and one write-up. Suits companies whose product is what
# the role works with; off = plan skill gaps only.
COMPANY_MODULE=off

# How interview prep researches the company. agent = the tool-calling loop (3-4 model
# calls, the model picks the searches). direct = both searches in parallel, then one
# small model call writing a short structured brief (~2-3k tokens per run).
COMPANY_RESEARCH_MODE=agent
# Model for that brief: default (the main model) or fast (FAST_LLM_* above).
COMPANY_RESEARCH_LLM=default
# Tool-call rounds the company research agent gets before it must stop and
# keep what it has gathered (it otherwise can keep re-searching).
COMPANY_RESEARCH_MAX_TOOL_ROUNDS=3

# --- Planner agent (agents/planner_agent.py) ---
# Every generated study plan is saved here as <plan id>.json for review.
# Relative paths resolve against agents-service/ (gitignored .data/). Empty disables saving.
PLAN_OUTPUT_DIR=.data/plans
# Default plan length (a run can override it: CLI --days, API plan_days). Days are
# split across skill gaps by priority (missing skill = 2x a partial one), so a
# longer plan means more days per gap, not more research.
PLAN_TOTAL_DAYS=45
# Depth over breadth: the plan covers at most this many skill gaps (highest priority
# first; the rest are listed under coverage.not_scheduled), and never more than fit
# with PLAN_MIN_DAYS_PER_TOPIC days each. Keep PLAN_MAX_TOPICS <= RESEARCH_MAX_GAPS so
# every planned topic has references. 0 = no cap.
PLAN_MAX_TOPICS=6
PLAN_MIN_DAYS_PER_TOPIC=3
# Most book references placed in the day schedule of one plan (one per topic, on its
# first day). Every book found stays in the resource pack.
PLAN_MAX_BOOKS=2
# Likewise for research papers.
PLAN_MAX_PAPERS=2
# Longest sprint; a gap with more days becomes several sprints.
PLAN_SPRINT_MAX_DAYS=7
# Most days one planner LLM call writes, so no call grows with plan length.
PLANNER_DAYS_PER_CALL=10
# Most skill gaps researched per run (highest priority first). Bounds research
# time and SerpApi credits; gaps past it are still planned, without references.
RESEARCH_MAX_GAPS=6
# Concurrent LLM calls where a stage fans out. 0 = auto: 1 for Ollama (local and
# Ollama Cloud measured no faster in parallel), 4 for OpenAI. Raise for an Ollama
# server started with OLLAMA_NUM_PARALLEL.
LLM_MAX_CONCURRENCY=0

# --- Runtime & messaging ---
# Console/file log verbosity.
LOG_LEVEL=INFO
# Rotating log location; empty disables file logging and keeps console output only.
LOG_FILE=.data/logs/agents-service.log
LOG_FILE_MAX_BYTES=5000000
# Redis is used for Node/Python SSE event delivery and event-history replay.
REDIS_URL=redis://localhost:6379
# Major execution-path switch: true emits the scripted SSE demo for ordinary runs;
# false executes the real LangGraph. Interview-prep workflow requests always execute the real graph.
USE_DUMMY_STREAM=true
# Enables token streaming where supported; Redis/SSE primarily sends step/domain events.
STREAM_RESPONSES=true
# Optional JWT secret. Python auth bypass is controlled by ENABLE_AUTH in src/auth.py;
# set that constant to true before relying on JWT validation in production.
JWT_SECRET=
# Require JWT verification in development when true. Production always enforces auth.
ENABLE_AUTH=false
